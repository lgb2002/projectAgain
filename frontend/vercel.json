{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://REPLACE_WITH_BACKEND_DOMAIN/api/:path*"},
    {"source": "/health", "destination": "https://REPLACE_WITH_BACKEND_DOMAIN/health"},
    {"source": "/docs", "destination": "https://REPLACE_WITH_BACKEND_DOMAIN/docs"},
    {"source": "/openapi.json", "destination": "https://REPLACE_WITH_BACKEND_DOMAIN/openapi.json"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
