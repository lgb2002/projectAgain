# 실제 비밀값을 이 파일에 기록하지 마세요. Replit Secrets/환경 변수로 설정.
APP_ENV=development
# Production requires PostgreSQL and a strong, random JWT_SECRET.
DATABASE_URL=sqlite:///./marketplace_dev.sqlite3
JWT_SECRET=SET_A_NEW_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
# Replace with your actual site URL when configuring verification links.
PUBLIC_BASE_URL=http://localhost:5173
# SMTP is optional in development; required for real email verification.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# Set these only when creating an admin via the CLI; do not commit values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Phase 2: private files. In production, PRIVATE_STORAGE_BACKEND must be replit.
# NEVER use local storage for a public/prod Replit deployment (ephemeral filesystem).
PRIVATE_STORAGE_BACKEND=local
# PRIVATE_STORAGE_DIR=/tmp/micro_asset_private_files
# In Replit App Storage create and attach a private bucket manually using UI.
# REPLIT_STORAGE_BUCKET_ID=your-attached-bucket-id (omit if default bucket attached)
# Install backend/requirements-storage.txt for the official Python SDK (Python 3.12).
# If available, install ClamAV manually and configure CLAMAV_BINARY=/usr/bin/clamscan.
# For PRODUCTION, unscanned assets cannot be approved or shared.
# CLAMAV_BINARY=/usr/bin/clamscan
# Limit uploads to 10MB initially; change only after storage/cost/security review.
ASSET_MAX_BYTES=10485760

# 에이전트의 외부 API 쓰기 작업은 기본 비활성화. 승인된 DEMO에서만 demo_only 사용.
AGENT_WRITE_MODE=disabled

# v0.6: GitHub App integration. Public repository URL import works without these.
# Create a GitHub App with Metadata read and Contents read-only permissions.
# Callback URL must match this exact path and production must use HTTPS.
# GITHUB_CLIENT_ID=Iv1_... (GitHub App Client ID, not App ID)
# GITHUB_CLIENT_SECRET=...
# GITHUB_CALLBACK_URL=https://YOUR-SITE.replit.app/api/v1/github/callback
# GITHUB_APP_SLUG=your-github-app-name
# Required in production for encrypted token storage; use a stable high-entropy secret.
# GITHUB_TOKEN_ENCRYPTION_KEY=RANDOM_LONG_SECRET_AT_LEAST_40_CHARACTERS
# Temporary imported source objects expire after two hours; clean up regularly:
# bash scripts/cleanup_staged_imports.sh

# v0.7 — Optional email notifications. In-app notifications always work.
# SMTP requires a separate worker process: bash scripts/run_notification_worker.sh
# SMTP_USE_STARTTLS=1
# SMTP credentials must never be embedded in frontend builds or repository files.
# PUBLIC_BASE_URL=https://your-actual-project-domain.example
